<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Add-ons and home streaming servers are often plain http on the LAN or the internet. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
	<!-- Injected at build time by the release workflow (see project.yml). -->
	<key>EncoreRepository</key>
	<string>$(ENCORE_REPOSITORY)</string>
	<key>EncoreCloudURL</key>
	<string>$(ENCORE_CLOUD_URL)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Encore connects to a streaming server on your network to play torrent sources.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
